
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "Client",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "Server",
      "framework": "express",
      "entrypoint": "api/index.ts",
      "bindings": [
        {
          "type": "service",
          "service": "career_api",
          "format": "url",
          "env": "CAREER_API_URL"
        },
        {
          "type": "service",
          "service": "kundali_api",
          "format": "url",
          "env": "KUNDALI_API_URL"
        },
        {
          "type": "service",
          "service": "parental_api",
          "format": "url",
          "env": "PARENTAL_API_URL"
        },
        {
          "type": "service",
          "service": "society_api",
          "format": "url",
          "env": "SOCIETY_API_URL"
        }
      ]
    },
    "career_api": {
      "root": "models/career_api",
      "framework": "fastapi",
      "entrypoint": "main.py"
    },
    "kundali_api": {
      "root": "models/kundali_api",
      "framework": "fastapi",
      "entrypoint": "main.py"
    },
    "market_api": {
      "root": "models/market_api",
      "framework": "fastapi",
      "entrypoint": "main.py"
    },
    "parental_api": {
      "root": "models/parental_api",
      "framework": "fastapi",
      "entrypoint": "app_parent.py"
    },
    "society_api": {
      "root": "models/society_api",
      "framework": "fastapi",
      "entrypoint": "main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/market",
      "destination": {
        "service": "market_api"
      }
    },
    {
      "source": "/market/(.*)",
      "destination": {
        "service": "market_api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
